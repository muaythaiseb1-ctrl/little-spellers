# Copy this file to .env and fill in your own values. Never commit .env.
# On a hosting service, set these as environment variables instead.

# Teacher login
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Long random string used to sign login tokens. If it is left empty, a new one
# is made each time the server starts and everyone has to log in again.
# You can make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
